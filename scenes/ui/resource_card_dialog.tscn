[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/resource_card_dialog.gd" id="script"]
[ext_resource type="PackedScene" path="res://scenes/ui/resource_choice.tscn" id="picker"]
[ext_resource type="PackedScene" path="res://scenes/ui/dialog.tscn" id="base"]

[node name="ResourceCard" instance=ExtResource("base")]
script = ExtResource("script")

[node name="Effect" type="Label" parent="DialogMargin/Panel/Frame/DialogScroll/Body"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="FirstLabel" type="Label" parent="DialogMargin/Panel/Frame/DialogScroll/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SectionLabel"
uppercase = true

[node name="First" parent="DialogMargin/Panel/Frame/DialogScroll/Body" instance=ExtResource("picker")]
unique_name_in_owner = true
layout_mode = 2

[node name="SecondLabel" type="Label" parent="DialogMargin/Panel/Frame/DialogScroll/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SectionLabel"
text = "Second resource"
uppercase = true

[node name="Second" parent="DialogMargin/Panel/Frame/DialogScroll/Body" instance=ExtResource("picker")]
unique_name_in_owner = true
layout_mode = 2

[node name="Reason" type="Label" parent="DialogMargin/Panel/Frame/DialogScroll/Body"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"ErrorLabel"
autowrap_mode = 3

[node name="Back" type="Button" parent="DialogMargin/Panel/Frame/Footer" groups=["ui_click"]]
custom_minimum_size = Vector2(120, 40)
layout_mode = 2
size_flags_vertical = 0
mouse_default_cursor_shape = 2
text = "Back"

[node name="PlayCard" type="Button" parent="DialogMargin/Panel/Frame/Footer" groups=["ui_click"]]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 40)
layout_mode = 2
size_flags_vertical = 0
mouse_default_cursor_shape = 2
theme_type_variation = &"PrimaryButton"
text = "Play card"

[connection signal="pressed" from="DialogMargin/Panel/Frame/Footer/Back" to="." method="close"]
[connection signal="pressed" from="DialogMargin/Panel/Frame/Footer/PlayCard" to="." method="_on_play_pressed"]
[connection signal="changed" from="DialogMargin/Panel/Frame/DialogScroll/Body/First" to="." method="_on_choice_changed"]
[connection signal="changed" from="DialogMargin/Panel/Frame/DialogScroll/Body/Second" to="." method="_on_choice_changed"]
