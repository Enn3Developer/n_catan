[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/dialog.gd" id="script"]

[node name="Dialog" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("script")

[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.12, 0.085, 0.05, 0.78)

[node name="DialogMargin" type="MarginContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 32

[node name="Panel" type="PanelContainer" parent="DialogMargin"]
layout_mode = 2
size_flags_vertical = 4

[node name="DialogScroll" type="ScrollContainer" parent="DialogMargin/Panel"]
unique_name_in_owner = true
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Body" type="VBoxContainer" parent="DialogMargin/Panel/DialogScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="Title" type="Label" parent="DialogMargin/Panel/DialogScroll/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeadingLabel"
theme_override_colors/font_color = Color(0.54902, 0.321569, 0.176471, 1)
theme_override_font_sizes/font_size = 28

[connection signal="resized" from="." to="." method="fit"]
[connection signal="minimum_size_changed" from="DialogMargin/Panel/DialogScroll/Body" to="." method="fit"]
