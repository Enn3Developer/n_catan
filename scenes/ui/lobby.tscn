[connection signal="pressed" from="Frame/Header/LobbyCosmetics" to="." method="emit_signal" binds= ["cosmetics_requested"]]
[connection signal="pressed" from="Frame/Header/LobbySettings" to="." method="emit_signal" binds= ["settings_requested"]]
[connection signal="pressed" from="Frame/Header/OpenMusic" to="." method="emit_signal" binds= ["music_requested"]]
[connection signal="pressed" from="Frame/Columns/Left/Crew/CrewBody/CrewActions/AddBot" to="." method="emit_signal" binds= ["add_bot_requested"]]
[connection signal="pressed" from="Frame/Columns/Left/Crew/CrewBody/CrewActions/ReadyButton" to="." method="emit_signal" binds= ["ready_requested"]]
[connection signal="text_changed" from="Frame/Columns/Voyage/VoyageBody/InviteAddress" to="." method="_on_invite_address_text_changed"]
[connection signal="pressed" from="Frame/Columns/Voyage/VoyageBody/InviteActions/CopyInvite" to="." method="_on_copy_invite_pressed"]
[connection signal="pressed" from="Frame/Columns/Voyage/VoyageBody/InviteActions/MapRouter" to="." method="emit_signal" binds= ["map_router_requested"]]
[connection signal="pressed" from="Frame/Columns/Voyage/VoyageBody/StartGame" to="." method="emit_signal" binds= ["start_requested"]]
[connection signal="pressed" from="Frame/Columns/Voyage/VoyageBody/LeaveRoom" to="." method="emit_signal" binds= ["leave_requested"]]
[connection signal="text_submitted" from="Frame/Columns/Left/RoomRules/RulesBody/RulesGrid/SeedRow/SeedField" to="." method="_on_seed_submitted"]
[connection signal="focus_exited" from="Frame/Columns/Left/RoomRules/RulesBody/RulesGrid/SeedRow/SeedField" to="." method="_on_seed_focus_exited"]
[connection signal="pressed" from="Frame/Columns/Left/RoomRules/RulesBody/RulesGrid/SeedRow/NewSeed" to="." method="_on_new_seed_pressed"]
[connection signal="item_selected" from="Frame/Columns/Left/RoomRules/RulesBody/RulesGrid/IslandPicker" to="." method="_on_island_selected"]
[connection signal="item_selected" from="Frame/Columns/Left/RoomRules/RulesBody/RulesGrid/TimerPicker" to="." method="_on_timer_selected"]
[connection signal="item_selected" from="Frame/Columns/Left/RoomRules/RulesBody/RulesGrid/PointsPicker" to="." method="_on_points_selected"]
[connection signal="toggled" from="Frame/Columns/Left/RoomRules/RulesBody/RulesGrid/FriendlyRobber" to="." method="_on_friendly_robber_toggled"]
