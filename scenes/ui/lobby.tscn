layout_mode = 2
size_flags_horizontal = 3
mouse_default_cursor_shape = 2

[node name="TimerLabel" type="Label" parent="Frame/Columns/Left/RoomRules/RulesBody/RulesGrid"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "Turn timer"

[node name="TimerPicker" type="OptionButton" parent="Frame/Columns/Left/RoomRules/RulesBody/RulesGrid"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "When a turn runs out, the host finishes it with the shortest legal moves."
mouse_default_cursor_shape = 2

[node name="PointsLabel" type="Label" parent="Frame/Columns/Left/RoomRules/RulesBody/RulesGrid"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "Points to win"

[node name="PointsPicker" type="OptionButton" parent="Frame/Columns/Left/RoomRules/RulesBody/RulesGrid"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
size_flags_horizontal = 3
mouse_default_cursor_shape = 2

[node name="RobberLabel" type="Label" parent="Frame/Columns/Left/RoomRules/RulesBody/RulesGrid"]
