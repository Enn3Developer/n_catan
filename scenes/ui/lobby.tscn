[gd_scene format=3]

[ext_resource type="Theme" path="res://assets/ui_theme.tres" id="1"]
[ext_resource type="Script" path="res://scripts/lobby_screen.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/icons/music.svg" id="icon_music"]
[ext_resource type="Texture2D" path="res://assets/icons/settings.svg" id="icon_settings"]

[node name="Lobby" type="Control"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("1")
script = ExtResource("script")

[node name="Frame" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 24.0
offset_right = -24.0
offset_bottom = -24.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 16

[node name="Header" type="HBoxContainer" parent="Frame"]
unique_name_in_owner = true
layout_mode = 2

[node name="LobbyTitle" type="Label" parent="Frame/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HeadingLabel"
theme_override_colors/font_color = Color(1, 0.945098, 0.823529, 1)
theme_override_colors/font_outline_color = Color(0.286275, 0.207843, 0.129412, 1)
theme_override_constants/outline_size = 3
theme_override_font_sizes/font_size = 30
text = "Your room"

[node name="LobbyCosmetics" type="Button" parent="Frame/Header" groups=["ui_click"]]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
mouse_default_cursor_shape = 2
text = "Workshop"

[node name="LobbySettings" type="Button" parent="Frame/Header" groups=["ui_click"]]
unique_name_in_owner = true
custom_minimum_size = Vector2(40, 40)
layout_mode = 2
tooltip_text = "Settings"
mouse_default_cursor_shape = 2
theme_override_constants/icon_max_width = 22
icon = ExtResource("icon_settings")

[node name="OpenMusic" type="Button" parent="Frame/Header" groups=["ui_click"]]
unique_name_in_owner = true
custom_minimum_size = Vector2(34, 30)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Music"
mouse_default_cursor_shape = 2
theme_type_variation = &"MusicIconButton"
theme_override_constants/icon_max_width = 18
icon = ExtResource("icon_music")

[node name="Columns" type="HBoxContainer" parent="Frame"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 18

[node name="Left" type="VBoxContainer" parent="Frame/Columns"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Crew" type="PanelContainer" parent="Frame/Columns/Left"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="CrewBody" type="VBoxContainer" parent="Frame/Columns/Left/Crew"]
unique_name_in_owner = true
layout_mode = 2

[node name="CrewHeader" type="HBoxContainer" parent="Frame/Columns/Left/Crew/CrewBody"]
unique_name_in_owner = true
layout_mode = 2

[node name="CrewTitle" type="Label" parent="Frame/Columns/Left/Crew/CrewBody/CrewHeader"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 18
text = "Players"

[node name="PlayerCount" type="Label" parent="Frame/Columns/Left/Crew/CrewBody/CrewHeader"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "1 / 6"

[node name="CrewScroll" type="ScrollContainer" parent="Frame/Columns/Left/Crew/CrewBody"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="PlayerSlots" type="VBoxContainer" parent="Frame/Columns/Left/Crew/CrewBody/CrewScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="CrewActions" type="HBoxContainer" parent="Frame/Columns/Left/Crew/CrewBody"]
unique_name_in_owner = true
layout_mode = 2

[node name="AddBot" type="Button" parent="Frame/Columns/Left/Crew/CrewBody/CrewActions" groups=["ui_click"]]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
size_flags_horizontal = 3
mouse_default_cursor_shape = 2
text = "+ Add bot"

[node name="ReadyButton" type="Button" parent="Frame/Columns/Left/Crew/CrewBody/CrewActions" groups=["ui_click"]]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
size_flags_horizontal = 3
mouse_default_cursor_shape = 2
