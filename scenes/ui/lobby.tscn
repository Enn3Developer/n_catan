[node name="RoomRules" type="PanelContainer" parent="Frame/Columns/Left"]
unique_name_in_owner = true
layout_mode = 2

[node name="RulesBody" type="VBoxContainer" parent="Frame/Columns/Left/RoomRules"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="RulesHeader" type="HBoxContainer" parent="Frame/Columns/Left/RoomRules/RulesBody"]
layout_mode = 2

[node name="RulesTitle" type="Label" parent="Frame/Columns/Left/RoomRules/RulesBody/RulesHeader"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 18
text = "Room rules"

[node name="RulesGrid" type="GridContainer" parent="Frame/Columns/Left/RoomRules/RulesBody"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 8
columns = 4

[node name="SeedLabel" type="Label" parent="Frame/Columns/Left/RoomRules/RulesBody/RulesGrid"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "Map seed"

[node name="SeedRow" type="HBoxContainer" parent="Frame/Columns/Left/RoomRules/RulesBody/RulesGrid"]
layout_mode = 2
size_flags_horizontal = 3

[node name="SeedField" type="LineEdit" parent="Frame/Columns/Left/RoomRules/RulesBody/RulesGrid/SeedRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(96, 38)
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "The same seed and player count always build the same island. Share it to replay a map."
max_length = 9
virtual_keyboard_type = 2

[node name="NewSeed" type="Button" parent="Frame/Columns/Left/RoomRules/RulesBody/RulesGrid/SeedRow" groups=["ui_click"]]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
tooltip_text = "Pick a new random seed"
mouse_default_cursor_shape = 2
text = "New"

[node name="IslandLabel" type="Label" parent="Frame/Columns/Left/RoomRules/RulesBody/RulesGrid"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
