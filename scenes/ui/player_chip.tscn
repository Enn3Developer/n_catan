[node name="Knights" type="HBoxContainer" parent="ChipBody/Info/PlayerStats"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 0
theme_override_constants/separation = 4

[node name="Icon" type="TextureRect" parent="ChipBody/Info/PlayerStats/Knights"]
