[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/discard_dialog.gd" id="script"]
[ext_resource type="Script" path="res://scripts/resource_steppers.gd" id="steppers"]
[ext_resource type="PackedScene" path="res://scenes/ui/dialog.tscn" id="base"]

[node name="Discard" instance=ExtResource("base")]
script = ExtResource("script")

[node name="Title" parent="DialogMargin/Panel/Frame/DialogScroll/Body"]
text = "A seven was rolled"

[node name="Instructions" type="Label" parent="DialogMargin/Panel/Frame/DialogScroll/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 18

[node name="Steppers" type="HBoxContainer" parent="DialogMargin/Panel/Frame/DialogScroll/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8
script = ExtResource("steppers")

[node name="Chosen" type="Label" parent="DialogMargin/Panel/Frame/DialogScroll/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"

[node name="Close" type="Button" parent="DialogMargin/Panel/Frame/Footer" groups=["ui_click"]]
custom_minimum_size = Vector2(120, 40)
layout_mode = 2
size_flags_vertical = 0
mouse_default_cursor_shape = 2
text = "Close"

[node name="DiscardSelected" type="Button" parent="DialogMargin/Panel/Frame/Footer" groups=["ui_click"]]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 40)
layout_mode = 2
size_flags_vertical = 0
mouse_default_cursor_shape = 2
theme_type_variation = &"PrimaryButton"
text = "Discard"

[connection signal="pressed" from="DialogMargin/Panel/Frame/Footer/Close" to="." method="close"]
[connection signal="changed" from="DialogMargin/Panel/Frame/DialogScroll/Body/Steppers" to="." method="_on_amount_changed"]
[connection signal="pressed" from="DialogMargin/Panel/Frame/Footer/DiscardSelected" to="." method="_on_discard_pressed"]
