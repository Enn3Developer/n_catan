[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/music_track_row.gd" id="script"]

[node name="MusicTrack" type="HBoxContainer"]
script = ExtResource("script")

[node name="Track" type="Button" parent="." groups=["ui_click"]]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 0
mouse_default_cursor_shape = 2
theme_type_variation = &"ListButton"
toggle_mode = true
alignment = 0

[node name="Duration" type="Label" parent="Track"]
layout_mode = 1
anchors_preset = 11
anchor_left = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -64.0
offset_right = -14.0
grow_horizontal = 0
grow_vertical = 2
mouse_filter = 2
theme_type_variation = &"MutedLabel"
horizontal_alignment = 2
vertical_alignment = 1

[connection signal="pressed" from="Track" to="." method="emit_signal" binds= ["chosen"]]
