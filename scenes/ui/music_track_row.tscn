[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/music_track_row.gd" id="script"]

[sub_resource type="StyleBoxFlat" id="Selected"]
content_margin_left = 16.0
content_margin_top = 8.0
content_margin_right = 16.0
content_margin_bottom = 8.0
bg_color = Color(0.8, 0.858824, 0.698039, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.67451, 0.52549, 0.329412, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
shadow_color = Color(0.18, 0.1, 0.04, 0.18)
shadow_size = 3
shadow_offset = Vector2(0, 2)

[node name="MusicTrack" type="HBoxContainer"]
script = ExtResource("script")

[node name="Track" type="Button" parent="." groups=["ui_click"]]
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 0
mouse_default_cursor_shape = 2
theme_override_colors/font_pressed_color = Color(0.286275, 0.207843, 0.129412, 1)
theme_override_colors/font_hover_pressed_color = Color(0.286275, 0.207843, 0.129412, 1)
theme_override_styles/pressed = SubResource("Selected")
theme_override_styles/hover_pressed = SubResource("Selected")
toggle_mode = true

[node name="Duration" type="Label" parent="."]
layout_mode = 2
theme_override_colors/font_color = Color(0.47451, 0.388235, 0.278431, 1)
theme_override_font_sizes/font_size = 14

[connection signal="pressed" from="Track" to="." method="emit_signal" binds= ["chosen"]]
