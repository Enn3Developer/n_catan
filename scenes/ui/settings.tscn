[gd_scene format=3]
[ext_resource type="Theme" path="res://assets/ui_theme.tres" id="1"]
[ext_resource type="Script" path="res://scripts/settings_menu.gd" id="2"]
[node name="Settings" type="Control"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1")
script = ExtResource("2")

[node name="Shade" type="ColorRect" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.12, 0.085, 0.05, 0.86)

[node name="Margin" type="MarginContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="SettingsPanel" type="PanelContainer" parent="Margin"]
unique_name_in_owner = true
layout_mode = 2

[node name="Frame" type="HBoxContainer" parent="Margin/SettingsPanel"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Sidebar" type="VBoxContainer" parent="Margin/SettingsPanel/Frame"]
custom_minimum_size = Vector2(180, 0)
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Margin/SettingsPanel/Frame/Sidebar"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeadingLabel"
theme_override_font_sizes/font_size = 30
text = "Settings"

[node name="Navigation" type="VBoxContainer" parent="Margin/SettingsPanel/Frame/Sidebar"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6

[node name="Spacer" type="Control" parent="Margin/SettingsPanel/Frame/Sidebar"]
layout_mode = 2
size_flags_vertical = 3

[node name="Version" type="Label" parent="Margin/SettingsPanel/Frame/Sidebar"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 13

[node name="Content" type="VBoxContainer" parent="Margin/SettingsPanel/Frame"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="PageTitle" type="Label" parent="Margin/SettingsPanel/Frame/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 45)
layout_mode = 2
theme_type_variation = &"HeadingLabel"
theme_override_font_sizes/font_size = 24
vertical_alignment = 2

[node name="PageScroll" type="ScrollContainer" parent="Margin/SettingsPanel/Frame/Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Pages" type="VBoxContainer" parent="Margin/SettingsPanel/Frame/Content/PageScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="RendererNote" type="Label" parent="Margin/SettingsPanel/Frame/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 14
text = "Some lighting features require Forward+. Restart using the default renderer to enable them."
autowrap_mode = 3

[node name="Help" type="PanelContainer" parent="Margin/SettingsPanel/Frame/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 112)
layout_mode = 2
theme_type_variation = &"Card"

[node name="HelpBox" type="VBoxContainer" parent="Margin/SettingsPanel/Frame/Content/Help"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="HelpHeading" type="HBoxContainer" parent="Margin/SettingsPanel/Frame/Content/Help/HelpBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="HelpTitle" type="Label" parent="Margin/SettingsPanel/Frame/Content/Help/HelpBox/HelpHeading"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HeadingLabel"
theme_override_font_sizes/font_size = 18

[node name="HelpCost" type="Label" parent="Margin/SettingsPanel/Frame/Content/Help/HelpBox/HelpHeading"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 14

[node name="HelpBody" type="Label" parent="Margin/SettingsPanel/Frame/Content/Help/HelpBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 15
autowrap_mode = 3

[node name="Footer" type="HBoxContainer" parent="Margin/SettingsPanel/Frame/Content"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="SettingsNote" type="Label" parent="Margin/SettingsPanel/Frame/Content/Footer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 14
text = "Saved automatically"

[node name="ResetSettings" type="Button" parent="Margin/SettingsPanel/Frame/Content/Footer" groups=["ui_click"]]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
mouse_default_cursor_shape = 2
text = "Restore defaults"

[node name="CloseSettings" type="Button" parent="Margin/SettingsPanel/Frame/Content/Footer" groups=["ui_click"]]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 40)
layout_mode = 2
mouse_default_cursor_shape = 2
theme_type_variation = &"PrimaryButton"
text = "Done"

[connection signal="resized" from="." to="." method="_layout"]
[connection signal="pressed" from="Margin/SettingsPanel/Frame/Content/Footer/ResetSettings" to="." method="_on_reset_pressed"]
[connection signal="pressed" from="Margin/SettingsPanel/Frame/Content/Footer/CloseSettings" to="." method="emit_signal" binds= ["close_requested"]]
