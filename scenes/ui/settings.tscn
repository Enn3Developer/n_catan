[gd_scene format=3]
[ext_resource type="Theme" path="res://assets/ui_theme.tres" id="1"]
[ext_resource type="Script" path="res://scripts/settings_menu.gd" id="2"]
[node name="Settings" type="Control"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("1")
script = ExtResource("2")
[node name="Shade" type="ColorRect" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
offset_left = 0.0
offset_top = 0.0
offset_right = -0.0
offset_bottom = -0.0
color = Color(0.12, 0.085, 0.05, 0.86)
[node name="SettingsPanel" type="PanelContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
offset_left = 20.0
offset_top = 20.0
offset_right = -20.0
offset_bottom = -20.0

[node name="Body" type="VBoxContainer" parent="SettingsPanel"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12
[node name="Title" type="Label" parent="SettingsPanel/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeadingLabel"
text = "Settings"
theme_override_font_sizes/font_size = 30

[node name="Navigation" type="HFlowContainer" parent="SettingsPanel/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 6
[node name="GraphicsTab" type="Button" parent="SettingsPanel/Body/Navigation"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
toggle_mode = true
text = "Graphics"
alignment = 0

[node name="WorldTab" type="Button" parent="SettingsPanel/Body/Navigation"]
unique_name_in_owner = true
