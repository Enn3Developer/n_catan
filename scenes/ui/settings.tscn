[node name="ExitDesktop" type="Button" parent="SettingsPanel/Body/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Exit to desktop"
custom_minimum_size = Vector2(0, 40)

[connection signal="resized" from="." to="." method="_layout"]
[connection signal="pressed" from="SettingsPanel/Body/Navigation/GraphicsTab" to="." method="select_tab" binds= ["Graphics"]]
[connection signal="pressed" from="SettingsPanel/Body/Navigation/WorldTab" to="." method="select_tab" binds= ["World"]]
[connection signal="pressed" from="SettingsPanel/Body/Navigation/AudioTab" to="." method="select_tab" binds= ["Audio"]]
[connection signal="pressed" from="SettingsPanel/Body/Buttons/OpenUpdates" to="." method="emit_signal" binds= ["updates_requested"]]
[connection signal="pressed" from="SettingsPanel/Body/Buttons/ResetSettings" to="." method="_on_reset_pressed"]
[connection signal="pressed" from="SettingsPanel/Body/Buttons/CloseSettings" to="." method="emit_signal" binds= ["close_requested"]]
[connection signal="pressed" from="SettingsPanel/Body/Buttons/ExitDesktop" to="." method="emit_signal" binds= ["exit_requested"]]
