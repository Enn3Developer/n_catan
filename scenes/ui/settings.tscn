[node name="OpenUpdates" type="Button" parent="SettingsPanel/Body/Buttons" groups=["ui_click"]]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
size_flags_vertical = 0
mouse_default_cursor_shape = 2
text = "Updates"

[node name="SettingsNote" type="Label" parent="SettingsPanel/Body/Buttons"]
unique_name_in_owner = true
layout_mode = 2
