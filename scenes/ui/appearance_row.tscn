[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/appearance_row.gd" id="script"]

[node name="AppearanceRow" type="PanelContainer"]
theme_type_variation = &"Row"
script = ExtResource("script")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 16
autowrap_mode = 3

[node name="Value" type="Label" parent="Row"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(48, 0)
layout_mode = 2
horizontal_alignment = 2
