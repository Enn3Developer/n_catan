[connection signal="item_selected" from="Margin/Panel/Layout/Heading/CosmeticPlayer" to="." method="_target_changed"]
[connection signal="gui_input" from="Margin/Panel/Layout/Content/PreviewBox/PiecePreview" to="." method="_preview_input"]
[connection signal="pressed" from="Margin/Panel/Layout/Content/PreviewBox/PreviewBar/ShowSettlement" to="." method="show_piece" binds= ["settlement"]]
[connection signal="pressed" from="Margin/Panel/Layout/Content/PreviewBox/PreviewBar/ShowCity" to="." method="show_piece" binds= ["city"]]
[connection signal="pressed" from="Margin/Panel/Layout/Content/PreviewBox/PreviewBar/ShowRoad" to="." method="show_piece" binds= ["road"]]
[connection signal="toggled" from="Margin/Panel/Layout/Content/PreviewBox/PreviewBar/NightPreview" to="." method="_on_night_toggled"]
[connection signal="pressed" from="Margin/Panel/Layout/Content/Editor/SectionBar/ShuffleSection" to="." method="shuffle_section"]
[connection signal="pressed" from="Margin/Panel/Layout/Content/Editor/FieldScroll/Fields/PlayerColorBox/UseSeatColor" to="." method="_on_use_seat_color_pressed"]
[connection signal="pressed" from="Margin/Panel/Layout/Bottom/Undo" to="." method="undo"]
[connection signal="pressed" from="Margin/Panel/Layout/Bottom/Revert" to="." method="revert" binds= [true]]
[connection signal="pressed" from="Margin/Panel/Layout/Bottom/ApplyLook" to="." method="apply"]
[connection signal="pressed" from="Margin/Panel/Layout/Bottom/CloseCosmetics" to="." method="emit_signal" binds= ["close_requested"]]
