layout_mode = 2
size_flags_vertical = 0
mouse_default_cursor_shape = 2
theme_type_variation = &"PrimaryButton"
text = "Offer to all players"

[connection signal="item_selected" from="DialogMargin/Panel/Frame/DialogScroll/Body/GiveRow/GivePicker" to="." method="_on_selection_changed"]
[connection signal="value_changed" from="DialogMargin/Panel/Frame/DialogScroll/Body/GiveRow/GiveAmount" to="." method="_on_selection_changed"]
[connection signal="item_selected" from="DialogMargin/Panel/Frame/DialogScroll/Body/ReceiveRow/ReceivePicker" to="." method="_on_selection_changed"]
[connection signal="value_changed" from="DialogMargin/Panel/Frame/DialogScroll/Body/ReceiveRow/ReceiveAmount" to="." method="_on_selection_changed"]
[connection signal="pressed" from="DialogMargin/Panel/Frame/Footer/Close" to="." method="close"]
[connection signal="pressed" from="DialogMargin/Panel/Frame/DialogScroll/Body/Tabs/BankTab" to="." method="_refresh"]
[connection signal="pressed" from="DialogMargin/Panel/Frame/DialogScroll/Body/Tabs/PlayersTab" to="." method="_on_players_tab_pressed"]
[connection signal="pressed" from="DialogMargin/Panel/Frame/Footer/BankTrade" to="." method="_on_bank_trade_pressed"]
[connection signal="pressed" from="DialogMargin/Panel/Frame/Footer/OfferTrade" to="." method="_on_offer_trade_pressed"]
