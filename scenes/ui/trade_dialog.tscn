[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/trade_dialog.gd" id="script"]
[ext_resource type="PackedScene" path="res://scenes/ui/resource_picker.tscn" id="picker"]
[ext_resource type="Texture2D" path="res://assets/icons/timber.svg" id="icon_timber"]
[ext_resource type="Texture2D" path="res://assets/icons/brick.svg" id="icon_brick"]
[ext_resource type="Texture2D" path="res://assets/icons/wool.svg" id="icon_wool"]
[ext_resource type="Texture2D" path="res://assets/icons/grain.svg" id="icon_grain"]
[ext_resource type="Texture2D" path="res://assets/icons/ore.svg" id="icon_ore"]
[ext_resource type="PackedScene" path="res://scenes/ui/dialog.tscn" id="base"]

[sub_resource type="ButtonGroup" id="TradeModeGroup"]
resource_local_to_scene = true

[node name="TradeDialog" instance=ExtResource("base")]
script = ExtResource("script")

[node name="Title" parent="DialogMargin/Panel/Frame/DialogScroll/Body"]
text = "Trade"

[node name="Tabs" type="HBoxContainer" parent="DialogMargin/Panel/Frame/DialogScroll/Body"]
layout_mode = 2

[node name="BankTab" type="Button" parent="DialogMargin/Panel/Frame/DialogScroll/Body/Tabs"]
unique_name_in_owner = true
layout_mode = 2
toggle_mode = true
button_group = SubResource("TradeModeGroup")
text = "Bank"

[node name="PlayersTab" type="Button" parent="DialogMargin/Panel/Frame/DialogScroll/Body/Tabs"]
unique_name_in_owner = true
layout_mode = 2
toggle_mode = true
button_group = SubResource("TradeModeGroup")
text = "Players"

[node name="GiveLabel" type="Label" parent="DialogMargin/Panel/Frame/DialogScroll/Body"]
layout_mode = 2
theme_type_variation = &"SectionLabel"
text = "Give"
uppercase = true

[node name="GiveRow" type="HBoxContainer" parent="DialogMargin/Panel/Frame/DialogScroll/Body"]
layout_mode = 2

[node name="GiveChoices" type="HBoxContainer" parent="DialogMargin/Panel/Frame/DialogScroll/Body/GiveRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="Timber" type="Button" parent="DialogMargin/Panel/Frame/DialogScroll/Body/GiveRow/GiveChoices" groups=["ui_click"]]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 0
mouse_default_cursor_shape = 2
theme_override_colors/icon_normal_color = Color(1, 1, 1, 1)
theme_override_colors/icon_hover_color = Color(1, 1, 1, 1)
theme_override_colors/icon_pressed_color = Color(1, 1, 1, 1)
theme_override_colors/icon_hover_pressed_color = Color(1, 1, 1, 1)
theme_override_constants/h_separation = 6
theme_override_constants/icon_max_width = 24
toggle_mode = true
icon = ExtResource("icon_timber")
expand_icon = true

[node name="Brick" type="Button" parent="DialogMargin/Panel/Frame/DialogScroll/Body/GiveRow/GiveChoices" groups=["ui_click"]]
