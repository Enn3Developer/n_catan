[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/offer_dialog.gd" id="script"]
[ext_resource type="PackedScene" path="res://scenes/ui/resource_row.tscn" id="resource_row"]
[ext_resource type="PackedScene" path="res://scenes/ui/dialog.tscn" id="base"]

[node name="TradeOffer" instance=ExtResource("base")]
script = ExtResource("script")

[node name="Title" parent="DialogMargin/Panel/DialogScroll/Body"]
text = "A trade on the table"

[node name="Offerer" type="Label" parent="DialogMargin/Panel/DialogScroll/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeadingLabel"
theme_override_font_sizes/font_size = 20

[node name="Give" parent="DialogMargin/Panel/DialogScroll/Body" instance=ExtResource("resource_row")]
unique_name_in_owner = true
layout_mode = 2
icon_size = 38

[node name="InReturn" type="Label" parent="DialogMargin/Panel/DialogScroll/Body"]
layout_mode = 2
theme_type_variation = &"HeadingLabel"
theme_override_font_sizes/font_size = 20
text = "In return for:"

[node name="Receive" parent="DialogMargin/Panel/DialogScroll/Body" instance=ExtResource("resource_row")]
unique_name_in_owner = true
layout_mode = 2
icon_size = 38

[node name="Accept" type="Button" parent="DialogMargin/Panel/DialogScroll/Body" groups=["ui_click"]]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
size_flags_vertical = 0
mouse_default_cursor_shape = 2
theme_type_variation = &"PrimaryButton"
text = "Accept trade"

[node name="Missing" type="Label" parent="DialogMargin/Panel/DialogScroll/Body"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.47451, 0.388235, 0.278431, 1)
theme_override_font_sizes/font_size = 14
autowrap_mode = 3

[node name="Withdraw" type="Button" parent="DialogMargin/Panel/DialogScroll/Body" groups=["ui_click"]]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
size_flags_vertical = 0
mouse_default_cursor_shape = 2
text = "Withdraw offer"

[node name="Close" type="Button" parent="DialogMargin/Panel/DialogScroll/Body" groups=["ui_click"]]
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
size_flags_vertical = 0
mouse_default_cursor_shape = 2
text = "Close"

[connection signal="pressed" from="DialogMargin/Panel/DialogScroll/Body/Close" to="." method="close"]
[connection signal="pressed" from="DialogMargin/Panel/DialogScroll/Body/Accept" to="." method="emit_signal" binds= ["accept_requested"]]
[connection signal="pressed" from="DialogMargin/Panel/DialogScroll/Body/Withdraw" to="." method="emit_signal" binds= ["withdraw_requested"]]
