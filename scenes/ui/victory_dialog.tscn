[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/victory_dialog.gd" id="script"]
[ext_resource type="PackedScene" path="res://scenes/ui/dialog.tscn" id="base"]

[node name="Victory" instance=ExtResource("base")]
script = ExtResource("script")

[node name="Title" parent="DialogMargin/Panel/Frame/DialogScroll/Body"]
auto_translate_mode = 2
text = "Victory"

[node name="Summary" type="Label" parent="DialogMargin/Panel/Frame/DialogScroll/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 15
autowrap_mode = 3

[node name="Stats" type="GridContainer" parent="DialogMargin/Panel/Frame/DialogScroll/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 14
theme_override_constants/v_separation = 6
columns = 7

[node name="DiceHeading" type="Label" parent="DialogMargin/Panel/Frame/DialogScroll/Body"]
layout_mode = 2
theme_type_variation = &"HeadingLabel"
theme_override_font_sizes/font_size = 20
text = "Dice rolls"

[node name="Dice" type="HBoxContainer" parent="DialogMargin/Panel/Frame/DialogScroll/Body"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
theme_override_constants/separation = 6

[node name="ShowLog" type="Button" parent="DialogMargin/Panel/Frame/Footer" groups=["ui_click"]]
custom_minimum_size = Vector2(120, 40)
layout_mode = 2
mouse_default_cursor_shape = 2
text = "Game log"

[node name="BackToMenu" type="Button" parent="DialogMargin/Panel/Frame/Footer" groups=["ui_click"]]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 40)
layout_mode = 2
mouse_default_cursor_shape = 2
text = "Back to menu"

[node name="PlayAgain" type="Button" parent="DialogMargin/Panel/Frame/Footer" groups=["ui_click"]]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 40)
layout_mode = 2
size_flags_vertical = 0
mouse_default_cursor_shape = 2
theme_type_variation = &"PrimaryButton"
text = "Play again"

[connection signal="pressed" from="DialogMargin/Panel/Frame/Footer/PlayAgain" to="." method="emit_signal" binds= ["rematch_requested"]]
[connection signal="pressed" from="DialogMargin/Panel/Frame/Footer/ShowLog" to="." method="emit_signal" binds= ["log_requested"]]
[connection signal="pressed" from="DialogMargin/Panel/Frame/Footer/BackToMenu" to="." method="emit_signal" binds= ["leave_requested"]]
