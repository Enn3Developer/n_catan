[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/victory_dialog.gd" id="script"]
[ext_resource type="PackedScene" path="res://scenes/ui/dialog.tscn" id="base"]

[node name="Victory" instance=ExtResource("base")]
script = ExtResource("script")

[node name="Title" parent="DialogMargin/Panel/DialogScroll/Body"]
text = "Victory"

[node name="Winner" type="Label" parent="DialogMargin/Panel/DialogScroll/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeadingLabel"
theme_override_colors/font_color = Color(0.54902, 0.321569, 0.176471, 1)
theme_override_font_sizes/font_size = 30

[node name="BackToMenu" type="Button" parent="DialogMargin/Panel/DialogScroll/Body" groups=["ui_click"]]
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
size_flags_vertical = 0
mouse_default_cursor_shape = 2
theme_type_variation = &"PrimaryButton"
text = "Back to menu"

[connection signal="pressed" from="DialogMargin/Panel/DialogScroll/Body/BackToMenu" to="." method="emit_signal" binds= ["leave_requested"]]
