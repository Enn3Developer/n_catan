[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/notification_card.gd" id="script"]

[sub_resource type="StyleBoxFlat" id="CardPanel"]
content_margin_left = 14.0
content_margin_top = 12.0
content_margin_right = 14.0
content_margin_bottom = 12.0
bg_color = Color(0.952941, 0.870588, 0.705882, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.54902, 0.321569, 0.176471, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

[node name="NotificationCard" type="PanelContainer"]
theme_override_styles/panel = SubResource("CardPanel")
script = ExtResource("script")

[node name="Body" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Message" type="Label" parent="Body"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 16
autowrap_mode = 3

[node name="Buttons" type="HBoxContainer" parent="Body"]
layout_mode = 2

[node name="Action" type="Button" parent="Body/Buttons"]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="Dismiss" type="Button" parent="Body/Buttons"]
layout_mode = 2
text = "Dismiss"

[node name="Timer" type="Timer" parent="."]
one_shot = true

[connection signal="pressed" from="Body/Buttons/Action" to="." method="emit_signal" binds= ["acted"]]
[connection signal="pressed" from="Body/Buttons/Dismiss" to="." method="emit_signal" binds= ["dismissed"]]
[connection signal="timeout" from="Timer" to="." method="emit_signal" binds= ["dismissed"]]
